/* ============================================================
   Default Style Theme for UniDecl UIToolkit
   —— 标准 Unity 编辑器风格（Pro Dark）

   设计约定
   1) 颜色与圆角集中为 .ud-root 上的 --ud-* 设计令牌，规则体只引用令牌，
      不再就地写死色值；换主题 = 换令牌，不必逐条改规则。
   2) 令牌值取自团结/Unity 编辑器真实主题实测：
      button #585858、input #2A2A2A、toolbar #3C3C3C、border #232323、
      text #D2D2D2。
   3) USS 的 var() 没有回退值语法：令牌未定义会静默丢弃整条属性，
      因此令牌必须覆盖到每个使用者（UIToolkitRenderManager.RenderRoot
      保证 .ud-root 是所有渲染树的祖先）。
   4) 尺寸对齐 Unity 原生控件：Button 19px、输入框 18px、Label 15px、
      Toolbar 21px、Toggle 14px、Foldout 20px。
   5) 布局（flex/align/尺寸）属于结构，由 C# 给出；本文件只负责"皮囊"。
   中文界面字体：微软雅黑 msyh.ttc
   ============================================================ */

.ud-root {
    /* ── 表面 ─────────────────────────────────────────────── */
    --ud-surface-base: #282828;
    --ud-surface-window: #383838;
    --ud-surface-toolbar: #3c3c3c;
    --ud-surface-titlebar: #3e3e3e;
    --ud-surface-input: #2a2a2a;
    --ud-surface-button: #585858;
    --ud-surface-button-hover: #676767;
    --ud-surface-button-pressed: #46627c;
    --ud-surface-toggle-on: #505050;
    --ud-surface-dropdown: #515151;
    --ud-surface-tab: #353535;
    --ud-surface-alt-row: #3f3f3f;
    --ud-surface-hover: rgba(255, 255, 255, 0.063);
    --ud-surface-sunken: rgba(0, 0, 0, 0.18);
    --ud-surface-box: rgba(40, 40, 40, 0.3);
    --ud-surface-raised: rgba(255, 255, 255, 0.03);

    /* ── 描边 ─────────────────────────────────────────────── */
    --ud-border: #232323;
    --ud-border-strong: #303030;
    --ud-border-input: #212121;
    --ud-border-subtle: rgba(255, 255, 255, 0.08);

    /* ── 文字 ─────────────────────────────────────────────── */
    --ud-text: #d2d2d2;
    --ud-text-bright: #eeeeee;
    --ud-text-dim: #a5a5a5;
    --ud-text-muted: #808080;
    --ud-text-disabled: #6a6a6a;
    --ud-text-link: #4c7eff;
    --ud-text-code: #d4d4d4;

    /* ── 强调 / 语义 ──────────────────────────────────────── */
    --ud-accent: #2c5d87;
    --ud-accent-hover: #356e9f;
    --ud-accent-border: #4c7eff;
    --ud-accent-soft: rgba(76, 126, 255, 0.55);
    --ud-success: #66cc66;
    --ud-warning: #f4bc02;
    --ud-error: #d32222;

    /* ── 度量 ─────────────────────────────────────────────── */
    --ud-radius: 3px;
    --ud-radius-lg: 4px;

    --unity-font: resource("Fonts/msyh");
    -unity-font: resource("Fonts/msyh");
    -unity-font-definition: resource("Fonts/msyh");
    -unity-font-style: normal;
    font-size: 12px;
    color: var(--ud-text);
    padding: 8px;
    flex-direction: column;
    flex-grow: 1;
    min-height: 0;
}

.ud-root-scrollview,
.ue5-root-scrollview {
    flex-grow: 1;
    min-height: 0;
}

.ud-root-scrollview > .unity-scroll-view__content-container,
.ue5-root-scrollview > .unity-scroll-view__content-container {
    padding-left: 2px;
    padding-right: 2px;
}

/* ============================================================
   容器：面板 / 卡片
   ============================================================ */

.ud-panel,
.ud-card {
    padding: 6px;
    margin-bottom: 6px;
    border-width: 1px;
    border-color: var(--ud-border-subtle);
    border-radius: var(--ud-radius);
    background-color: var(--ud-surface-box);
    flex-direction: column;
    align-items: stretch;
}

.ud-card-title {
    font-size: 12px;
    color: var(--ud-text-bright);
    margin-bottom: 4px;
    padding-bottom: 3px;
    border-bottom-width: 1px;
    border-bottom-color: var(--ud-border-strong);
    -unity-font-style: bold;
}

/* 布局容器：只声明结构，避免继承 .ud-root 的 padding 造成逐层缩进。
   轴向/交叉轴对齐属于"类型级布局"，由主题定义（渲染器不再内联）。 */
.ud-vertical-layout {
    flex-direction: column;
    align-items: stretch;
    padding: 0px;
}

.ud-horizontal-layout {
    flex-direction: row;
    align-items: center;
    padding: 0px;
}

/* 拖拽分隔条（VisualSplitter 渲染为非 Unity 内建 VisualSplitter 的容器） */
.ud-splitter {
    flex-direction: row;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

/* ============================================================
   文本
   ============================================================ */

.ud-label {
    color: var(--ud-text);
    font-size: 12px;
}

/* 字段型原子控件的共通 flex 行为——占满剩余空间且允许压缩。
   适用于 PropertyGrid 的 Hor{label, value} 布局：label 列固定宽度，value 列占满剩余。
   用户通过 UITKStyle 内联设置 flexGrow/flexShrink 优先级高于 USS，可覆盖此默认值。 */
.ud-field {
    flex-grow: 1;
    flex-shrink: 1;
}

.ud-label--heading {
    font-size: 15px;
    -unity-font-style: bold;
    color: var(--ud-text-bright);
    margin-bottom: 4px;
}

.ud-label--subheading {
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--ud-text);
    margin-top: 6px;
    margin-bottom: 4px;
}

.ud-label--divider {
    font-size: 11px;
    -unity-font-style: bold;
    color: var(--ud-text-dim);
    margin-top: 6px;
    margin-bottom: 4px;
}

.ud-label--muted {
    color: var(--ud-text-muted);
}

/* ============================================================
   按钮（对齐 Unity Button：19px / radius 3 / #585858）
   ============================================================ */

.ud-button {
    min-height: 19px;
    border-width: 1px;
    border-color: var(--ud-border-strong);
    border-radius: var(--ud-radius);
    background-color: var(--ud-surface-button);
    color: var(--ud-text-bright);
    font-size: 12px;
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 1px;
    padding-bottom: 1px;
    margin-bottom: 1px;
    -unity-text-align: middle-center;
}

.ud-button:hover {
    background-color: var(--ud-surface-button-hover);
}

.ud-button:active {
    background-color: var(--ud-surface-button-pressed);
}

/* 工具栏按钮保持 Unity 原生皮肤（透明底 + 悬停高亮），此处只校准高度 */
.ud-toolbar-button,
.ud-toolbar-menu,
.ud-toolbar-toggle {
    min-height: 19px;
}

.ud-button--primary {
    background-color: var(--ud-accent);
    border-color: var(--ud-accent-border);
    color: var(--ud-text-bright);
}

.ud-button--primary:hover {
    background-color: var(--ud-accent-hover);
}

.ud-button--secondary {
    background-color: var(--ud-surface-sunken);
    border-width: 1px;
    border-color: var(--ud-border-strong);
    color: var(--ud-text);
}

.ud-button--danger {
    border-width: 1px;
    border-color: rgba(211, 34, 34, 0.55);
    color: #e58a8a;
}

.ud-button-row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-bottom: 4px;
}

/* ============================================================
   侧边栏（导航容器）
   ============================================================ */

.ud-sidebar {
    background-color: var(--ud-surface-sunken);
    border-right-width: 1px;
    border-right-color: var(--ud-border-strong);
    padding: 4px;
}

.ud-sidebar-theme-row {
    flex-wrap: nowrap;
    justify-content: flex-start;
    margin-bottom: 6px;
}

.ud-sidebar-theme-row .ud-button,
.ud-sidebar-theme-row .ud-button--secondary {
    min-width: 0px;
    flex-grow: 1;
    flex-shrink: 1;
    padding-left: 8px;
    padding-right: 8px;
    margin-right: 4px;
    margin-bottom: 0px;
}

.ud-sidebar-scroll {
    padding-left: 1px;
    padding-right: 1px;
}

/* ============================================================
   输入类字段（对齐 Unity unity-text-input：18px / #2A2A2A）
   ============================================================ */

.ud-textfield,
.ud-numfield,
.ud-dropdown,
.ud-enumfield,
.ud-colorfield {
    min-height: 18px;
    margin-bottom: 2px;
    font-size: 12px;
}

.ud-textfield .unity-text-element,
.ud-numfield .unity-text-element,
.ud-dropdown .unity-text-element,
.ud-enumfield .unity-text-element {
    color: var(--ud-text);
}

.ud-toggle {
    min-height: 14px;
    margin-bottom: 3px;
    font-size: 12px;
}

.ud-foldout {
    min-height: 20px;
    margin-bottom: 2px;
}

.ud-slider {
    margin-bottom: 4px;
    min-height: 18px;
    /* 字段行内滑条填满 Value 列（PropertyGrid Hor{label,value} 布局约定） */
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    align-self: stretch;
}

/* ============================================================
   PropertyGrid 行 / 标签
   ============================================================ */

/* Hor{label, value} 行容器——皮囊在 USS，宽高对齐 Unity 检视面板行高 */
.ud-property-row {
    min-height: 19px;
    margin-bottom: 2px;
    padding-top: 0px;
    padding-bottom: 0px;
}

.ud-field-label {
    color: var(--ud-text);
    font-size: 12px;
    -unity-text-align: middle-left;
}

.ud-field-label--disabled {
    color: var(--ud-text-disabled);
}

/* ============================================================
   Tab 分页
   ============================================================ */

.ud-tabs {
    flex-direction: column;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0px;
}

/* 页签条：直接用 Unity 工具栏外观（底色/描边由主题提供），此处只校准内边距与行高 */
.ud-tabs__strip {
    flex-wrap: wrap;
    flex-shrink: 1;
    min-width: 0px;
    padding: 1px;
    min-height: 21px;
}

/* 页签内容区 */
.ud-tabs__content {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0px;
    flex-direction: column;
    padding: 6px 0px 0px 0px;
}

/* 单个页签（ToolbarToggle）：保留 Unity 工具栏皮肤（底色 + checked 高亮），
   此处只做页签条内的排版整合，避免与主题的 tab/checked 语义打架。
   等宽策略：flex-grow/shrink 均分 + min-width 0 允许压缩。 */
.ud-tabs__toggle {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0px;
    min-height: 17px;
    font-size: 12px;
    padding-left: 4px;
    padding-right: 4px;
    padding-top: 1px;
    padding-bottom: 1px;
    margin-left: 0px;
    margin-right: 1px;
    margin-bottom: 0px;
    -unity-text-align: middle-center;
}

.ud-tabs__toggle:checked {
    -unity-font-style: bold;
}

.ud-tabs__toggle .unity-toggle__label,
.ud-tabs__toggle .unity-toggle__text {
    -unity-text-align: middle-center;
    margin-left: 0px;
    margin-right: 0px;
}

/* ============================================================
   枚举按钮组
   ============================================================ */

.ud-enum-toggle-group {
    flex-direction: row;
    flex-wrap: wrap;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0px;
}

.ud-enum-toggle-group__button {
    /* 等宽平铺：均分剩余宽度并允许压缩，低于 min-width 时换行 */
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 64px;
    min-height: 19px;
    margin-right: 2px;
    margin-bottom: 2px;
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 1px;
    padding-bottom: 1px;
    border-width: 1px;
    border-color: var(--ud-border-strong);
    border-radius: var(--ud-radius);
    background-color: var(--ud-surface-button);
    color: var(--ud-text);
    font-size: 12px;
    -unity-text-align: middle-center;
}

.ud-enum-toggle-group__button:hover {
    background-color: var(--ud-surface-button-hover);
    color: var(--ud-text-bright);
}

/* 选中态需同时覆盖 :hover（特异性相同，后者需显式复述） */
.ud-enum-toggle-group__button--selected,
.ud-enum-toggle-group__button--selected:hover {
    background-color: var(--ud-surface-button-pressed);
    border-color: var(--ud-accent-border);
    color: var(--ud-text-bright);
    -unity-font-style: bold;
}

/* ============================================================
   进度条
   ============================================================ */

.ud-progress-bar__label {
    margin-bottom: 2px;
    color: var(--ud-text-dim);
}

.ud-progress-track {
    height: 6px;
    background-color: var(--ud-surface-input);
    border-width: 1px;
    border-color: var(--ud-border-strong);
    border-radius: var(--ud-radius);
    overflow: hidden;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    position: relative;
}

.ud-progress-fill {
    height: 6px;
    background-color: var(--ud-accent-hover);
    border-radius: var(--ud-radius);
    position: absolute;
    left: 0px;
    top: 0px;
}

/* ============================================================
   帮助框
   ============================================================ */

.ud-helpbox {
    margin-bottom: 6px;
    border-radius: var(--ud-radius);
}

.ud-helpbox-info {
    border-left-width: 3px;
    border-left-color: var(--ud-text-link);
}

.ud-helpbox-warning {
    border-left-width: 3px;
    border-left-color: var(--ud-warning);
}

.ud-helpbox-error {
    border-left-width: 3px;
    border-left-color: var(--ud-error);
}

/* ============================================================
   滚动容器
   ============================================================ */

.ud-scrollview {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

.ud-scrollview--compact,
.ue5-scrollview--compact {
    max-height: 150px;
}

.ud-scrollview .unity-scroll-view__content-container {
    padding-top: 0px;
    padding-bottom: 0px;
}

/* 紧凑列表项（Unity 列表行外观） */
.ud-scroll-item {
    padding: 4px 8px;
    min-height: 19px;
    color: var(--ud-text);
    border-bottom-width: 1px;
    border-bottom-color: var(--ud-border-subtle);
}

.ud-scroll-item:hover {
    background-color: var(--ud-surface-hover);
}

/* ============================================================
   工具栏
   ============================================================ */

.ud-toolbar {
    flex-direction: row;
    align-items: center;
    background-color: var(--ud-surface-toolbar);
    padding: 1px 2px;
    min-height: 21px;
}

.ud-toolbar > UnityEngine.UIElements.ToolbarButton,
.ud-toolbar .unity-toolbar-button,
.ud-toolbar > UnityEngine.UIElements.ToolbarMenu,
.ud-toolbar .unity-toolbar-menu,
.ud-toolbar > UnityEngine.UIElements.ToolbarToggle,
.ud-toolbar .unity-toolbar-toggle {
    flex-shrink: 0;
    margin-right: 2px;
    min-height: 19px;
}

.ud-toolbar > UnityEngine.UIElements.ToolbarToggle,
.ud-toolbar .unity-toolbar-toggle {
    min-width: 42px;
    padding-left: 4px;
    padding-right: 4px;
}

.ud-toolbar .unity-toolbar-toggle .unity-toggle__label,
.ud-toolbar .unity-toolbar-toggle .unity-toggle__text {
    -unity-text-align: middle-center;
    margin-left: 0px;
    margin-right: 0px;
}

.ud-toolbar .unity-toolbar-search-field {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 96px;
    flex-basis: 120px;
    margin-left: 2px;
    margin-right: 2px;
}

.ud-toolbar > UnityEngine.UIElements.ToolbarMenu,
.ud-toolbar .unity-toolbar-menu {
    min-width: 0px;
    margin-right: 0px;
}

/* ============================================================
   Markdown 标题（H1–H6）
   ============================================================ */

.ud-heading {
    -unity-font-style: bold;
    margin-top: 6px;
    margin-bottom: 4px;
    color: var(--ud-text-bright);
}

.ud-h1 {
    font-size: 28px;
    color: var(--ud-text-bright);
    margin-top: 10px;
    margin-bottom: 6px;
    padding-bottom: 4px;
    border-bottom-width: 1px;
    border-bottom-color: var(--ud-border-strong);
}

.ud-h2 {
    font-size: 22px;
    color: var(--ud-text-bright);
    margin-top: 8px;
    margin-bottom: 5px;
    padding-bottom: 3px;
    border-bottom-width: 1px;
    border-bottom-color: var(--ud-border-subtle);
}

.ud-h3 {
    font-size: 18px;
    color: var(--ud-text-bright);
    margin-top: 6px;
    margin-bottom: 4px;
}

.ud-h4 {
    font-size: 15px;
    color: var(--ud-text);
    margin-top: 5px;
    margin-bottom: 3px;
}

.ud-h5 {
    font-size: 13px;
    color: var(--ud-text);
    margin-top: 4px;
    margin-bottom: 2px;
}

.ud-h6 {
    font-size: 12px;
    color: var(--ud-text-dim);
    margin-top: 4px;
    margin-bottom: 2px;
}

/* ============================================================
   TocView —— 目录 / 左侧导航
   ============================================================ */

.ud-toc-view {
    flex-direction: column;
    background-color: var(--ud-surface-base);
    border-width: 1px;
    border-color: var(--ud-border);
    border-radius: var(--ud-radius);
    padding: 4px 3px;
}

.ud-toc-item {
    flex-direction: row;
    align-items: center;
    min-height: 19px;
    padding-top: 2px;
    padding-bottom: 2px;
    padding-right: 8px;
    padding-left: 6px;
    margin-left: 2px;
    margin-right: 2px;
    border-radius: var(--ud-radius);
    border-left-width: 0px;
    transition-duration: 80ms;
}

.ud-toc-item-label {
    font-size: 12px;
    color: var(--ud-text);
    flex-grow: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    padding-left: 4px;
}

.ud-toc-item--l1 > .ud-toc-item-label {
    -unity-font-style: bold;
    color: var(--ud-text-bright);
    font-size: 12px;
}

.ud-toc-item--l1 {
    margin-top: 2px;
    margin-bottom: 1px;
}

.ud-toc-item--l2 > .ud-toc-item-label {
    color: var(--ud-text);
}

.ud-toc-item--l2 {
    padding-left: 10px;
}

.ud-toc-item--l3 > .ud-toc-item-label,
.ud-toc-item--l4 > .ud-toc-item-label,
.ud-toc-item--l5 > .ud-toc-item-label,
.ud-toc-item--l6 > .ud-toc-item-label {
    color: var(--ud-text-dim);
    font-size: 11px;
}

.ud-toc-item--l3,
.ud-toc-item--l4,
.ud-toc-item--l5,
.ud-toc-item--l6 {
    padding-left: 14px;
}

/* 可点击项——光标与悬停高亮 */
.ud-toc-item--clickable {
    cursor: link;
}

.ud-toc-item--clickable:hover {
    background-color: var(--ud-surface-hover);
}

.ud-toc-item--clickable:active {
    background-color: var(--ud-surface-raised);
}

/* 选中项——Unity 选中态底色 + 左侧强调条 */
.ud-toc-item--selected {
    background-color: var(--ud-accent);
    border-left-width: 3px;
    border-left-color: var(--ud-accent-border);
    margin-left: 0px;
}

.ud-toc-item--selected:hover {
    background-color: var(--ud-accent-hover);
}

.ud-toc-item--selected > .ud-toc-item-label {
    color: var(--ud-text-bright);
}

/* 展开箭头 */
.ud-toc-chevron {
    font-size: 8px;
    color: var(--ud-text-muted);
    min-width: 14px;
    margin-right: 2px;
    flex-shrink: 0;
    -unity-text-align: middle-center;
    transition-duration: 120ms;
}

.ud-toc-item--has-children:hover > .ud-toc-chevron {
    color: var(--ud-text);
}

.ud-toc-item--selected > .ud-toc-chevron {
    color: var(--ud-text-bright);
}

/* 子级容器 */
.ud-toc-children {
    flex-direction: column;
    padding-left: 0px;
    margin-bottom: 2px;
}

/* ============================================================
   MarkdownView
   ============================================================ */

.ud-markdown {
    flex-grow: 1;
    flex-direction: column;
    padding: 8px 10px;
}

.ud-md-paragraph {
    margin-bottom: 8px;
    white-space: normal;
    -unity-paragraph-spacing: 4px;
}

.ud-md-text {
    color: var(--ud-text);
    font-size: 12px;
    white-space: normal;
    -unity-paragraph-spacing: 4px;
}

/* 含链接时使用的自动换行行 */
.ud-md-text-row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-bottom: 0px;
}

/* 强制换行占位 */
.ud-md-br {
    width: 100%;
    height: 2px;
}

.ud-md-link {
    color: var(--ud-text-link);
    font-size: 12px;
}

.ud-md-link--clickable {
    cursor: link;
    transition-duration: 150ms;
}

.ud-md-link--clickable:hover {
    color: #7ea8ff;
}

/* 图片占位（图标 + alt 文本） */
.ud-md-image-container {
    flex-direction: row;
    align-items: center;
    margin: 2px 4px;
    padding: 2px 6px;
    border-width: 1px;
    border-color: var(--ud-border-subtle);
    border-radius: var(--ud-radius);
    background-color: var(--ud-surface-sunken);
}

.ud-md-image-icon {
    width: 16px;
    height: 16px;
    margin-right: 4px;
    flex-shrink: 0;
}

.ud-md-image-alt {
    color: var(--ud-text-muted);
    font-size: 11px;
    -unity-font-style: italic;
}

/* 代码块 */
.ud-md-codeblock {
    background-color: var(--ud-surface-input);
    border-width: 1px;
    border-color: var(--ud-border);
    border-radius: var(--ud-radius-lg);
    padding: 0px;
    margin-top: 6px;
    margin-bottom: 10px;
    overflow: hidden;
    flex-direction: column;
    cursor: Text;
}

.ud-md-codeblock-lang {
    /* 标签条：语言名在左、复制按钮在右 */
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    font-size: 10px;
    color: var(--ud-text-muted);
    padding: 4px 10px 2px 10px;
    -unity-font-style: italic;
    border-bottom-width: 1px;
    border-bottom-color: var(--ud-border);
    background-color: var(--ud-surface-raised);
}

/* 无语言名时用于把复制按钮顶到右侧 */
.ud-md-codeblock-lang-spacer {
    flex-grow: 1;
}

.ud-md-codeblock-lang-text {
    -unity-font-style: bold;
}

.ud-md-codeblock-copy-btn {
    width: 20px;
    height: 20px;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    -unity-text-align: middle-center;
    background-color: transparent;
    border-width: 0px;
    padding-left: 4px;
    padding-right: 4px;
    margin-left: 4px;
    margin-right: 0px;
}

.ud-md-codeblock-copy-btn:hover {
    background-color: var(--ud-surface-hover);
    border-radius: var(--ud-radius);
}

.ud-md-codeblock-copy-btn:active {
    background-color: var(--ud-surface-raised);
    border-radius: var(--ud-radius);
}

/* 复制成功反馈——图标染色与文字回退两种形态 */
.ud-md-codeblock-copy-btn--ok {
    color: var(--ud-success);
}

.ud-md-codeblock-icon {
    width: 20px;
    height: 20px;
}

.ud-md-codeblock-icon--ok {
    -unity-background-image-tint-color: var(--ud-success);
}

.ud-md-code {
    color: var(--ud-text-code);
    font-size: 12px;
    white-space: nowrap;
    padding: 8px 10px;
    cursor: Text;
}

.ud-md-ul {
    margin-left: 8px;
    margin-top: 4px;
    margin-bottom: 8px;
    flex-direction: column;
}

.ud-md-ol {
    margin-left: 8px;
    margin-top: 4px;
    margin-bottom: 8px;
    flex-direction: column;
}

.ud-md-li {
    flex-direction: row;
    align-items: center;
    margin-bottom: 5px;
    padding-top: 0px;
    padding-bottom: 0px;
}

.ud-md-li-bullet {
    color: var(--ud-text-link);
    font-size: 13px;
    min-width: 16px;
    margin-right: 1px;
    -unity-text-align: middle-left;
    align-self: center;
    padding-top: 0px;
    padding-bottom: 0px;
    flex-shrink: 0;
}

.ud-md-li-content {
    flex-grow: 1;
    flex-shrink: 1;
    white-space: normal;
    -unity-paragraph-spacing: 1px;
    align-self: center;
}

/* 列表内 RichText 对齐——与 bullet/序号同基线 */
.ud-md-li-content .ud-md-text,
.ud-md-li-content .ud-md-text-row {
    margin-bottom: 0px;
    -unity-paragraph-spacing: 1px;
    -unity-text-align: middle-left;
    align-items: center;
}

.ud-md-blockquote {
    border-left-width: 3px;
    border-left-color: var(--ud-accent-soft);
    padding: 6px 10px;
    margin-top: 6px;
    margin-bottom: 10px;
    flex-direction: column;
    background-color: var(--ud-surface-raised);
    border-radius: 0px var(--ud-radius) var(--ud-radius) 0px;
}

.ud-md-blockquote .ud-md-paragraph,
.ud-md-blockquote .ud-md-text {
    margin-bottom: 4px;
}

.ud-md-blockquote .ud-md-ul,
.ud-md-blockquote .ud-md-ol {
    margin-top: 2px;
}

.ud-md-hr {
    height: 1px;
    background-color: var(--ud-border-strong);
    margin-top: 10px;
    margin-bottom: 10px;
}

/* ============================================================
   MdTable —— Markdown 表格
   ============================================================ */

.ud-md-table {
    flex-direction: column;
    border-width: 1px;
    border-color: var(--ud-border);
    border-radius: var(--ud-radius);
    margin-top: 6px;
    margin-bottom: 10px;
    overflow: hidden;
    flex-direction: column;
}

.ud-md-table-header {
    flex-direction: row;
    background-color: var(--ud-surface-titlebar);
    border-bottom-width: 1px;
    border-bottom-color: var(--ud-border);
}

.ud-md-table-header-cell {
    padding: 4px 10px;
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--ud-text-bright);
    flex-grow: 1;
    flex-shrink: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.ud-md-table-row {
    flex-direction: row;
    background-color: var(--ud-surface-base);
    border-bottom-width: 1px;
    border-bottom-color: var(--ud-border);
}

.ud-md-table-cell {
    padding: 4px 10px;
    font-size: 12px;
    color: var(--ud-text);
    flex-grow: 1;
    flex-shrink: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.ud-md-table-row:hover {
    background-color: var(--ud-surface-hover);
}

/* ============================================================
   导航 Ping 高亮环
   ============================================================ */

/* 该覆盖层由 OverlayEffectManager 动态挂载，保留字面量以免脱离 .ud-root 作用域 */
.ud-nav-ping-overlay {
    border-width: 2px;
    border-color: rgb(255, 200, 50);
    background-color: rgba(255, 200, 50, 0.08);
    border-radius: 4px;
    transition: opacity 0.6s ease-out;
}
